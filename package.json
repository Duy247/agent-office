{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "description": "A customizable local 3D office dashboard for Nightly Openbot, with read-only Team API integration and replaceable connectors.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Duy247/agent-office.git"
  },
  "homepage": "https://github.com/Duy247/agent-office#readme",
  "bugs": {
    "url": "https://github.com/Duy247/agent-office/issues"
  },
  "keywords": [
    "threejs",
    "typescript",
    "virtual-office",
    "agent-dashboard",
    "openbot",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node scripts/build-furniture.ts",
    "predev": "node scripts/build-furniture.ts",
    "postbuild": "node scripts/compress-assets.ts",
    "boss": "node scripts/configure-boss.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.ts",
    "predemo": "npm run build",
    "prestart": "npm run build",
    "start": "node src/server.ts",
    "dev": "vite",
    "demo": "node src/server.ts --connector demo",
    "package": "node scripts/package-template.ts",
    "proof": "node src/probe.ts watch",
    "build": "vite build",
    "connect": "node src/probe.ts connect",
    "probe": "node src/probe.ts discover",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.2.1",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2"
  }
}
